<Window x:Class="MicMuteTool.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD"
        Width="360"
        Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Visibility="Collapsed">
    <Window.Resources>
        <DropShadowEffect x:Key="OsdDropShadow"
                          Color="#66000000"
                          BlurRadius="20"
                          Opacity="0.7"
                          ShadowDepth="4" />
    </Window.Resources>
    <Border x:Name="RootBorder"
            CornerRadius="20"
            Padding="20"
            Background="#CC2ECC71"
            Effect="{StaticResource OsdDropShadow}"
            IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
            <Ellipse x:Name="StatusDot"
                     Width="20"
                     Height="20"
                     Fill="#FF2ECC71" />
            <TextBlock x:Name="StatusText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="麦克风已开启" />
        </StackPanel>
    </Border>
</Window>

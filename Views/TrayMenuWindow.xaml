<Window x:Class="MicMuteTool.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="180"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{Binding HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{Binding PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuIconStyle" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding IconBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TrayMenuTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TrayMenuSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{Binding OutlineBrush}" />
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Margin="6"
            CornerRadius="14"
            Padding="5"
            Background="{Binding SurfaceBrush}"
            BorderBrush="{Binding OutlineBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.22" />
        </Border.Effect>
        <StackPanel>
            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="Settings_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="SettingsIcon" Style="{StaticResource TrayMenuIconStyle}" />
                    <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource TrayMenuTextStyle}" />
                </Grid>
            </Button>

            <Button x:Name="LegacyButton" Style="{StaticResource TrayMenuButtonStyle}" Click="LegacySettings_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource TrayMenuIconStyle}" Data="M280,-280h400v-80H280v80Zm0,-160h400v-80H280v80Zm0,-160h400v-80H280v80ZM200,-120q-33,0-56.5,-23.5T120,-200v-560q0,-33,23.5,-56.5T200,-840h560q33,0,56.5,23.5T840,-760v560q0,33-23.5,56.5T760,-120H200Zm0,-80h560v-560H200v560Z" />
                    <TextBlock Grid.Column="1" Text="旧版 WPF 设置" Style="{StaticResource TrayMenuTextStyle}" />
                </Grid>
            </Button>

            <Border Style="{StaticResource TrayMenuSeparatorStyle}" />

            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="OsdToggle_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="OsdIcon" Style="{StaticResource TrayMenuIconStyle}" />
                    <TextBlock Grid.Column="1" Text="OSD 显示" Style="{StaticResource TrayMenuTextStyle}" />
                    <TextBlock Grid.Column="2" Text="{Binding OsdStatusText}" Foreground="{Binding SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="SoundToggle_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="SoundIcon" Style="{StaticResource TrayMenuIconStyle}" />
                    <TextBlock Grid.Column="1" Text="提示音通知" Style="{StaticResource TrayMenuTextStyle}" />
                    <TextBlock Grid.Column="2" Text="{Binding SoundStatusText}" Foreground="{Binding SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Style="{StaticResource TrayMenuSeparatorStyle}" />

            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="Exit_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource TrayMenuIconStyle}" Data="M200,-120q-33,0-56.5,-23.5T120,-200v-560q0,-33,23.5,-56.5T200,-840h280v80H200v560h280v80H200Zm440,-160-55,-58,102,-102H360v-80h327L585,-622l55,-58,200,200-200,200Z" />
                    <TextBlock Grid.Column="1" Text="退出" Style="{StaticResource TrayMenuTextStyle}" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>

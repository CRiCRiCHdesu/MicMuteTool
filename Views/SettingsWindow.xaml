<Window x:Class="MicMuteTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MicMuteTool 设置"
        Width="1180"
        Height="700"
        MinWidth="1024"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#060814"
        Foreground="#F3F5FF"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#090C1B" Offset="0" />
            <GradientStop Color="#131B34" Offset="0.45" />
            <GradientStop Color="#151B30" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A2035" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#394165" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8AEC7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#9B7BFF" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#8B6BFF" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="MdButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource AccentStrongBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MdOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource MdButtonStyle}">
            <Setter Property="Background" Value="#242C47" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#56618A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2D375A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#212A48" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DEE3F8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter Margin="2,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#273052" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#46527A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#7D66D9" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#A58FFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NudgeButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#242C47" />
            <Setter Property="BorderBrush" Value="#56618A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2D375A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#212A48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F4FF" />
            <Setter Property="Background" Value="#1E2540" />
            <Setter Property="BorderBrush" Value="#485279" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F4FF" />
            <Setter Property="Background" Value="#1E2540" />
            <Setter Property="BorderBrush" Value="#485279" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E9F8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="18" BorderBrush="#3C456A" BorderThickness="1" Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#10162B" CornerRadius="18,0,0,18" BorderBrush="#313A5D" BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,6,4,14">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#7D66D9" VerticalAlignment="Center">
                                <TextBlock Text="🎤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MicMuteTool" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="麦克风静音助手 By綾ななみ" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="HotkeyTabButton" Content="常规与热键" Click="HotkeyTabButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button x:Name="SoundTabButton" Content="提示音设置" Click="SoundTabButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button x:Name="MicrophoneTabButton" Content="麦克风管理" Click="MicrophoneTabButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button x:Name="OsdTabButton" Content="OSD 设置" Click="OsdTabButton_Click" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HotkeyTab" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="常规与热键" FontSize="40" FontWeight="Bold" Margin="0,0,0,16" />

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="常规设置" />
                                    <CheckBox Content="启用 OSD" IsChecked="{Binding EnableOsd, Mode=TwoWay}" />
                                    <Separator Margin="0,10,0,4" Opacity="0.25" />
                                    <CheckBox Content="启用提示音" IsChecked="{Binding EnableSound, Mode=TwoWay}" />
                                    <Separator Margin="0,10,0,4" Opacity="0.25" />
                                    <CheckBox Content="开机自启" IsChecked="{Binding RunOnStartup, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自定义热键" />
                                    <TextBlock Text="按下组合键以设置热键" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="40" CornerRadius="8" BorderThickness="1" BorderBrush="#485279" Background="#1E2540" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HotkeyDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                                        </Border>
                                        <Button Grid.Column="1" Margin="10,0,0,0" Content="修改热键" Style="{StaticResource MdButtonStyle}" Click="StartHotkeyCapture_Click" />
                                        <Button Grid.Column="2" Margin="10,0,0,0" Content="恢复默认" Style="{StaticResource MdOutlineButtonStyle}" Click="ResetHotkey_Click" />
                                    </Grid>

                                    <TextBlock x:Name="HotkeyHintText" Text="点击“设置热键”后，按下新的按键组合。按 ESC 取消。" Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SoundTab" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="提示音设置" FontSize="40" FontWeight="Bold" Margin="0,0,0,16" />


                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="开启音效文件" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding MicOnSoundPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览" Tag="MicOn" Click="BrowseSoundButton_Click" Style="{StaticResource MdOutlineButtonStyle}" MinWidth="84" />
                                        <Button Grid.Column="2" Margin="8,0,0,0" Content="恢复默认" Tag="MicOn" Click="ResetSoundButton_Click" Style="{StaticResource MdOutlineButtonStyle}" MinWidth="96" />
                                        <Button Grid.Column="3" Margin="8,0,0,0" Content="预览 ▶" Tag="MicOn" Click="TestSoundButton_Click" Style="{StaticResource MdOutlineButtonStyle}" MinWidth="88" Background="#2A3458" BorderBrush="#6B78A8" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="关闭音效文件" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding MicMutedSoundPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览" Tag="MicMuted" Click="BrowseSoundButton_Click" Style="{StaticResource MdOutlineButtonStyle}" MinWidth="84" />
                                        <Button Grid.Column="2" Margin="8,0,0,0" Content="恢复默认" Tag="MicMuted" Click="ResetSoundButton_Click" Style="{StaticResource MdOutlineButtonStyle}" MinWidth="96" />
                                        <Button Grid.Column="3" Margin="8,0,0,0" Content="预览 ▶" Tag="MicMuted" Click="TestSoundButton_Click" Style="{StaticResource MdOutlineButtonStyle}" MinWidth="88" Background="#2A3458" BorderBrush="#6B78A8" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音量" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding MicOnVolume, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding MicOnVolume, StringFormat={}{0:P0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer x:Name="MicrophoneTab" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="麦克风管理" FontSize="40" FontWeight="Bold" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <DockPanel>
                                <CheckBox Content="静音所有麦克风" IsChecked="{Binding MicrophoneMuteAll, Mode=TwoWay}" Margin="0" DockPanel.Dock="Left" />
                                <Button Content="刷新设备" DockPanel.Dock="Right" Style="{StaticResource MdOutlineButtonStyle}" Width="110" Click="RefreshMicrophonesButton_Click" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="选择需要控制的麦克风" />
                                <ListView ItemsSource="{Binding MicrophoneDevices}" BorderBrush="#485279" BorderThickness="1" MinHeight="72" MaxHeight="360" Background="#1B223A" Foreground="#E9EDFF" Opacity="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.Style>
                                        <Style TargetType="ListView">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MicrophoneSelectionEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.Style>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="6,8">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding DataContext.MicrophoneSelectionEnabled, RelativeSource={RelativeSource AncestorType=ListView}}" VerticalAlignment="Center" Margin="0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="18" />
                                                </CheckBox>
                                                <TextBlock Text="⋮" DockPanel.Dock="Right" Margin="10,0,0,0" Foreground="#97A0C8" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="选择的设备将受热键控制并显示 OSD 状态" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="OsdTab" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="OSD 设置" FontSize="40" FontWeight="Bold" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="文案与颜色" />

                                    <TextBlock Text="开启麦克风文案" Style="{StaticResource BodyTextStyle}" />
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,6,0,0" Text="{Binding OsdMicOnText, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="静音麦克风文案" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,6,0,0" Text="{Binding OsdMicMutedText, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="开启背景颜色" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,6,0,0" Text="{Binding OsdMicOnColor, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="静音背景颜色" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,6,0,0" Text="{Binding OsdMicMutedColor, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="尺寸与动画" />

                                    <TextBlock Text="OSD 宽度" Style="{StaticResource BodyTextStyle}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="50" Maximum="800" Value="{Binding OsdWidth, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding OsdWidth, StringFormat={}{0:0}px}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="OSD 高度" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="50" Maximum="300" Value="{Binding OsdHeight, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding OsdHeight, StringFormat={}{0:0}px}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="字体大小" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="16" Maximum="60" Value="{Binding OsdFontSize, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding OsdFontSize, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="背景透明度" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" />
                                    <Slider Margin="0,6,0,0" Minimum="0.05" Maximum="1.0" Value="{Binding OsdOpacity, Mode=TwoWay}" />

                                    <TextBlock Text="文字透明度" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" />
                                    <Slider Margin="0,6,0,0" Minimum="0.05" Maximum="1.0" Value="{Binding OsdContentOpacity, Mode=TwoWay}" />

                                    <CheckBox Content="启用淡入" IsChecked="{Binding OsdEnableFadeIn, Mode=TwoWay}" Margin="0,12,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,6,0,0" IsEnabled="{Binding OsdEnableFadeIn}" Text="{Binding OsdFadeInDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="启用淡出" IsChecked="{Binding OsdEnableFadeOut, Mode=TwoWay}" Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,6,0,0" IsEnabled="{Binding OsdEnableFadeOut}" Text="{Binding OsdFadeOutDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="位置与预览" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X:" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="8,0,10,0"
                                             Text="{Binding OsdPositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OsdIsLocked}" Value="False">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Margin="8,0,10,0"
                                             Text="{Binding OsdPositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OsdIsLocked}" Value="False">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <CheckBox x:Name="LockOsdCheckBox" Grid.Column="4" Content="锁定位置" Margin="0" VerticalAlignment="Center"
                                              IsChecked="{Binding OsdIsLocked, Mode=TwoWay}"
                                              Checked="LockOsdCheckBox_Checked"
                                              Unchecked="LockOsdCheckBox_Unchecked" />
                                    <Button Grid.Column="5" Margin="10,0,0,0" Content="重置位置" Click="ResetOsdPosition_Click" Style="{StaticResource MdOutlineButtonStyle}" />
                                </Grid>

                                <CheckBox Content="显示状态圆点" IsChecked="{Binding OsdShowStatusDot, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RepeatButton Content="←" Delay="250" Interval="60" Click="NudgeButton_Click" Tag="Left" Style="{StaticResource NudgeButtonStyle}" />
                                    <RepeatButton Content="→" Margin="8,0,0,0" Delay="250" Interval="60" Click="NudgeButton_Click" Tag="Right" Style="{StaticResource NudgeButtonStyle}" />
                                    <RepeatButton Content="↑" Margin="8,0,0,0" Delay="250" Interval="60" Click="NudgeButton_Click" Tag="Up" Style="{StaticResource NudgeButtonStyle}" />
                                    <RepeatButton Content="↓" Margin="8,0,0,0" Delay="250" Interval="60" Click="NudgeButton_Click" Tag="Down" Style="{StaticResource NudgeButtonStyle}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <RadioButton x:Name="PreviewStyleOnRadio" Content="开启样式" Foreground="#FFFFFF" IsChecked="True" Checked="PreviewStyleOnRadio_Checked" />
                                    <RadioButton x:Name="PreviewStyleMutedRadio" Content="静音样式" Foreground="#FFFFFF" Margin="24,0,0,0" Checked="PreviewStyleMutedRadio_Checked" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="PreviewToggleButton" Content="开启预览" Width="120" Click="PreviewToggleButton_Click" Style="{StaticResource MdButtonStyle}" />
                                    <Button Content="重置 OSD" Width="120" Margin="10,0,0,0" Click="ResetOsdButton_Click" Style="{StaticResource MdOutlineButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="保存" Width="130" Click="SaveButton_Click" Style="{StaticResource MdButtonStyle}" />
                    <Button Content="取消" Width="130" Margin="12,0,0,0" Click="CancelButton_Click" Style="{StaticResource MdOutlineButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
